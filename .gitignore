# ── Python (app/) ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
app.lock

# Runtime data — regenerable caches (kept out of git; included in zip backups)
app/cache.db
app/error_outbox.db

# v0.09.5 — Phase 0 tool output (vault scans, snapshots, dry-run reports).
# Generated artifacts for the owner, never source code.
app/reports/

# ── Node / Next.js (app/cloudflare-bot/dashboard) ───────────────
node_modules/
.next/
out/
dist/
*.tsbuildinfo
next-env.d.ts

# Local env overrides
.env*.local

# ── OS / editor ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp

# Live Telethon sessions — never commit (audit finding v0.0.10)
app/session.session*

# v0.06 — SECURITY: live credential stores. config.json currently holds the
# owner's real tokens (private-repo convenience from v0.04); gitignoring it
# prevents an accidental `git add .` from committing five live secrets.
# Use config.example.json as the template for fresh installs.
app/config.json
app/installer.config.json
app/cloudflare-bot/installer.config.json
app/config.local.json

# v0.06 — runtime logs / single-instance locks anywhere in the tree
**/logs/
app/app.lock

# ── Cloudflare wrangler local cache (never commit account cache) ──────────────
.wrangler/

# ── v0.25.0 hygiene pass ─────────────────────────────────────────
# Agent working notes + refactor tooling (see AGENTS.md) — never source.
.agent-notes/
.refactor-scratch/
# Python test tooling caches
.pytest_cache/
.coverage
# Release zip artifacts (built by tools/build_zip.py, never tracked)
*.zip

# ── v0.26.0 Tier B tidy ─────────────────────────────────────────
# The owner's personal bookmark export — personal data, repo is public;
# removed from the tree in v0.26.0. Never `git add` a local copy.
unique_links.csv
