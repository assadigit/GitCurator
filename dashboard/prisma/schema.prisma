// This is our Prisma schema file,
// learn more about the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// v30.2 — one row per POST /api/verify execution.
/// Powers the dashboard History tab: run trends, pass-rate stats and
/// code-drift detection (codeHash fingerprint of the audited Python tree).
model VerificationRun {
  id            String   @id @default(cuid())
  ranAt         DateTime @default(now())
  ok            Boolean
  durationMs    Int
  pythonVersion String
  testsTotal    Int
  testsPassed   Int
  compileOk     Int
  compileTotal  Int
  summaryLine   String
  /// sha256 over the 9 audited .py files — "which code version was verified"
  codeHash      String
  /// full VerifyResult JSON snapshot (compile grid + suites + cases)
  resultJson    String
  /// v0.0.4 provenance — who started the run:
  /// "manual" (Tests/History tab button), "startup" (scheduler first pass),
  /// "scheduled" (6-hour interval). Rows written before v0.0.4 default to
  /// "manual".
  source        String   @default("manual")

  @@index([ranAt])
}

/// v0.0.5 — one row per VaultSeal execution (post-run vault backup to
/// the private GitHub mirror). Powers the Vault Seal tab: protection
/// status, seal history timeline, and per-event outcomes.
model VaultSealEvent {
  id            String   @id @default(cuid())
  sealedAt      DateTime @default(now())
  /// "sealed" (a commit was created) | "skipped" (vault unchanged /
  /// disabled — a healthy no-op) | "failed" (error, commit may be local-only)
  status        String
  commitMessage String
  commitSha     String?
  filesChanged  Int      @default(0)
  pushed        Boolean  @default(false)
  repoName      String?
  repoUrl       String?
  repoPrivate   Boolean  @default(true)
  /// who produced the event: "app" (a real GitCurator run — GUI or
  /// headless), "demo" (dashboard-triggered local seal via app/vaultseal.py),
  /// "simulate" (plausible fake, for trying the timeline without a vault)
  source        String   @default("app")
  skippedReason String?
  error         String?
  durationMs    Int      @default(0)

  @@index([sealedAt])
}
