# Copy to .env and adjust if needed.
# SQLite database for verification-run history (Prisma).
# Relative paths resolve against dashboard/prisma/schema.prisma.
DATABASE_URL=file:../db/custom.db

# Optional: override where the dashboard finds the Python app tree
# (defaults to the sibling ../app directory of this dashboard).
# GITCURATOR_APP_DIR=/absolute/or/relative/path/to/app

# Optional: read-only GitHub token so /api/releases can show live
# GitHub Actions CI status (the repo is private, so the API needs
# a token). Without it the Releases tab shows "CI n/a".
# Use a dedicated fine-grained token with Actions:read only.
# GITCURATOR_GH_TOKEN=ghp_xxx

# Optional: where the Vault Seal tab (v0.0.5) finds the Obsidian vault to
# report on / seal. Defaults to <dashboard>/demo-vault when it exists,
# else no vault — the tab degrades to records-only. "Seal vault now"
# always runs the REAL app/vaultseal.py for a local commit; pushing stays
# the app's job (the dashboard holds no GitHub token by design).
# GITCURATOR_VAULT_DIR=/path/to/your/vault
